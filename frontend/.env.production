# Loaded automatically by `vite build` (mode=production), which is what Vercel runs.
#
# Without this, api.js falls back to '/api' — fine in dev, where vite.config.js
# proxies /api to localhost:5000, but on Vercel there is no proxy and every API
# call 404s against the static site.
#
# Safe to commit: VITE_* values are inlined into the public client bundle, so this
# can never hold a secret. A Vercel dashboard variable of the same name overrides
# it, since Vite prefers real process env over .env files.
VITE_API_URL=https://wandr-api-x4i8.onrender.com/api
